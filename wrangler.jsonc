{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Cloudflare Workers Builds project name / GitHub repo slug.
	"name": "brasileiroscatilicosutah",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "brasileiroscatolicosutah",
			"database_id": "85f0ef81-640b-4bd7-8793-603d344c68f8",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "brasileiroscatolicosutah-media"
		}
	],
	"observability": {
		"enabled": true
	}
}
