{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "brasileiroscatolicosutah",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "brasileiroscatolicosutah",
			"database_id": "local-dev-placeholder",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "brasileiroscatolicosutah-media"
		}
	],
	"observability": {
		"enabled": true
	}
}
