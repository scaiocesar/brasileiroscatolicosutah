---
import type { EventItem } from '../lib/types';
import { formatMonthYear, monthMatrix } from '../lib/dates';

interface Props {
	year: number;
	monthIndex: number;
	events: EventItem[];
	prevHref: string;
	nextHref: string;
}

const { year, monthIndex, events, prevHref, nextHref } = Astro.props;
const weeks = monthMatrix(year, monthIndex);
const weekdays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

const byDay = new Map<number, EventItem[]>();
for (const event of events) {
	const d = new Date(event.starts_at);
	const day = Number(
		new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', day: 'numeric' }).format(d),
	);
	const list = byDay.get(day) ?? [];
	list.push(event);
	byDay.set(day, list);
}
---

<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-card sm:p-6">
	<div class="mb-4 flex items-center justify-between gap-3">
		<a href={prevHref} class="rounded-full border border-slate-200 px-3 py-2 text-sm font-medium hover:bg-brand-cream">←</a>
		<h2 class="text-lg font-bold capitalize text-brand-blue">{formatMonthYear(year, monthIndex)}</h2>
		<a href={nextHref} class="rounded-full border border-slate-200 px-3 py-2 text-sm font-medium hover:bg-brand-cream">→</a>
	</div>

	<div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-slate-500 sm:text-sm">
		{weekdays.map((d) => <div class="py-2">{d}</div>)}
	</div>

	<div class="grid grid-cols-7 gap-1">
		{
			weeks.flat().map((day) => {
				const dayEvents = day ? byDay.get(day) ?? [] : [];
				return (
					<div
						class:list={[
							'min-h-16 rounded-lg border p-1 sm:min-h-20 sm:p-2',
							day ? 'border-slate-100 bg-brand-cream/40' : 'border-transparent',
							dayEvents.length > 0 && 'border-brand-blue/30 bg-blue-50',
						]}
					>
						{day && <div class="text-xs font-semibold text-slate-700">{day}</div>}
						{dayEvents.slice(0, 2).map((ev) => (
							<div class="mt-1 truncate rounded bg-brand-blue px-1 py-0.5 text-[10px] font-medium text-white sm:text-xs">
								{ev.title}
							</div>
						))}
					</div>
				);
			})
		}
	</div>
</section>
