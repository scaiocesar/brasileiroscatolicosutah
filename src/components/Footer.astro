---
import type { SiteSettings } from '../lib/types';
import SocialLinks from './SocialLinks.astro';
import { contactLines } from '../lib/db';

interface Props {
	settings: SiteSettings;
}

const { settings } = Astro.props;
const contacts = contactLines(settings.contacts);
---

<footer class="mt-auto border-t border-slate-200 bg-brand-blue-dark text-white">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
		<div>
			<img src="/images/logo.png" alt="" width="64" height="64" class="mb-3 h-16 w-16 rounded-full" />
			<p class="text-lg font-bold">{settings.site_name}</p>
			<p class="mt-1 text-sm text-blue-100">{settings.tagline}</p>
			<p class="mt-4 text-sm text-blue-100">
				Apoie também:
				<a
					href="https://brasileiroscatolicosusa.org/"
					target="_blank"
					rel="noopener noreferrer"
					class="font-semibold text-brand-gold underline-offset-2 hover:underline"
				>
					Brasileiros Católicos nos EUA
				</a>
			</p>
		</div>
		<div>
			<p class="font-semibold text-brand-gold">Contato</p>
			<p class="mt-2 text-sm text-blue-100">{settings.address}</p>
			{
				contacts.map((line) => (
					<p class="mt-1 text-sm text-blue-100">{line}</p>
				))
			}
		</div>
		<div>
			<p class="font-semibold text-brand-gold">Redes sociais</p>
			<div class="mt-3">
				<SocialLinks settings={settings} light />
			</div>
			<p class="mt-4 text-xs text-blue-200">
				Missa em português · Missa Utah · Brasileiros católicos Salt Lake City
			</p>
		</div>
	</div>
	<div class="border-t border-white/10 py-4 text-center text-xs text-blue-200">
		© {new Date().getFullYear()} {settings.site_name}. Todos os direitos reservados.
	</div>
</footer>
