---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb, getEventById, getSettings, isFeatureEnabled, mediaUrl } from '../../lib/db';
import { formatDateTimePt } from '../../lib/dates';

const db = getDb(Astro.locals);
const settings = await getSettings(db);

if (!isFeatureEnabled(settings.page_eventos_enabled)) {
	return Astro.redirect('/404');
}

const id = Number(Astro.params.id);
const event = await getEventById(db, id, { publishedOnly: true });

if (!event) {
	return Astro.redirect('/404');
}

const image = mediaUrl(event.image_key);
const description =
	event.description?.trim() ||
	`${event.title} — evento da comunidade Brasileiros Católicos Utah.`;
---

<BaseLayout
	title={event.title}
	description={description}
	settings={settings}
	ogImage={image ?? undefined}
	canonicalPath={`/eventos/${event.id}`}
>
	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
		<a href="/eventos" class="text-sm font-semibold text-brand-blue hover:underline">← Voltar aos eventos</a>

		<p class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand-blue">
			{formatDateTimePt(event.starts_at)}
			{event.ends_at && <> — {formatDateTimePt(event.ends_at)}</>}
		</p>
		<h1 class="mt-2 text-3xl font-extrabold text-brand-blue-dark sm:text-4xl">{event.title}</h1>
		{event.location && <p class="mt-3 text-slate-600">{event.location}</p>}

		{
			image && (
				<img
					src={image}
					alt={`Imagem do evento: ${event.title}`}
					width="1200"
					height="800"
					class="mt-8 w-full rounded-2xl object-cover shadow-card"
					loading="eager"
				/>
			)
		}

		{
			event.description && (
				<div class="mt-8 whitespace-pre-line text-base leading-relaxed text-slate-700 sm:text-lg">
					{event.description}
				</div>
			)
		}

		<a
			href="/eventos"
			class="mt-10 inline-flex rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-800 hover:bg-brand-cream"
		>
			Ver todos os eventos
		</a>
	</section>
</BaseLayout>
