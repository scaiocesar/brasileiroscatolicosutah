---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, getSettings, isFeatureEnabled, listPublishedArticles, mediaUrl } from '../lib/db';
import { plainTextFromHtml } from '../lib/html';
import { formatDatePt } from '../lib/dates';

const db = getDb(Astro.locals);
const settings = await getSettings(db);

if (!isFeatureEnabled(settings.page_artigos_enabled)) {
	return Astro.redirect('/404');
}

const articles = await listPublishedArticles(db);

function previewText(excerpt: string | null, body: string): string {
	if (excerpt?.trim()) return excerpt.trim();
	const plain = plainTextFromHtml(body);
	return plain.length > 160 ? `${plain.slice(0, 157)}…` : plain;
}
---

<BaseLayout
	title="Artigos"
	description="Artigos e reflexões da comunidade Brasileiros Católicos Utah: fé, cultura e vida em comum em Salt Lake City."
	settings={settings}
>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<p class="text-sm font-semibold uppercase tracking-wide text-brand-blue">Comunidade</p>
		<h1 class="mt-2 text-3xl font-extrabold text-brand-blue-dark sm:text-4xl">Artigos</h1>
		<p class="mt-4 max-w-3xl text-slate-700">
			Textos sobre nossa comunidade, fé católica e vivências em Utah.
		</p>

		{
			articles.length === 0 ? (
				<p class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-slate-600">
					Nenhum artigo publicado no momento. Volte em breve.
				</p>
			) : (
				<ul class="mt-8 space-y-3">
					{articles.map((article) => (
						<li>
							<a
								href={`/artigos/${article.id}`}
								class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-blue/40 hover:shadow-card sm:flex-row"
							>
								{mediaUrl(article.cover_image_key) && (
									<img
										src={mediaUrl(article.cover_image_key)!}
										alt=""
										class="h-36 w-full shrink-0 rounded-xl object-cover sm:h-24 sm:w-36"
										loading="lazy"
									/>
								)}
								<div class="min-w-0 flex-1">
									<p class="text-xs font-semibold uppercase text-brand-blue">
										{formatDatePt(article.published_at)}
									</p>
									<h2 class="mt-1 text-lg font-bold text-slate-900">{article.title}</h2>
									<p class="mt-2 line-clamp-2 text-sm text-slate-700">
										{previewText(article.excerpt, article.body)}
									</p>
									<span class="mt-2 inline-block text-sm font-semibold text-brand-blue">
										Ler artigo →
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>
