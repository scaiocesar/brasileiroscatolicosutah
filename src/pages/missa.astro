---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, getMassSchedule, getSettings, getActiveFeaturedMass, mediaUrl } from '../lib/db';
import { formatDateTimePt, getNextMonthlyMass } from '../lib/dates';
import FeaturedMassBanner from '../components/FeaturedMass.astro';

const db = getDb(Astro.locals);
const settings = await getSettings(db);
const schedule = await getMassSchedule(db);
const featured = await getActiveFeaturedMass(db);
const nextMass = getNextMonthlyMass();
---

<BaseLayout
	title="Horário da missa em português"
	description="Missa em português em utah: último domingo do mês às 6:00 PM na Igreja São José Operário, West Jordan. Brasileiros católicos em Salt Lake City."
	settings={settings}
>
	{featured && <FeaturedMassBanner featured={featured} mapsUrl={schedule.maps_url} />}

	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<p class="text-sm font-semibold uppercase tracking-wide text-brand-blue">Missa Utah</p>
		<h1 class="mt-2 text-3xl font-extrabold text-brand-blue-dark sm:text-4xl">
			Horário da missa em português
		</h1>
		<p class="mt-4 max-w-3xl text-slate-700">
			A comunidade de brasileiros católicos em Salt Lake City e região celebra a missa em português
			todo {schedule.recurrence.toLowerCase()}, às {schedule.time_label}, com {schedule.priest}.
		</p>

		<div class="mt-8 grid gap-6 md:grid-cols-2">
			<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
				<h2 class="text-xl font-bold text-brand-blue">Próxima celebração</h2>
				<p class="mt-3 text-lg font-semibold text-slate-900">{formatDateTimePt(nextMass)}</p>
				<dl class="mt-4 space-y-3 text-sm text-slate-700">
					<div>
						<dt class="font-semibold text-slate-900">Frequência</dt>
						<dd>{schedule.recurrence}</dd>
					</div>
					<div>
						<dt class="font-semibold text-slate-900">Horário</dt>
						<dd>{schedule.time_label}</dd>
					</div>
					<div>
						<dt class="font-semibold text-slate-900">Celebrante</dt>
						<dd>{schedule.priest}</dd>
					</div>
					{
						schedule.notes && (
							<div>
								<dt class="font-semibold text-slate-900">Observações</dt>
								<dd>{schedule.notes}</dd>
							</div>
						)
					}
				</dl>
			</article>

			<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
				<h2 class="text-xl font-bold text-brand-blue">Local</h2>
				<p class="mt-3 font-semibold text-slate-900">{schedule.church_name}</p>
				<p class="mt-2 text-slate-700">{schedule.address}</p>
				<p class="mt-2 text-sm text-slate-600">
					Perto de Salt Lake City — ideal para quem busca missa em português em utah.
				</p>
				<a
					href={schedule.maps_url}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-5 inline-flex rounded-full bg-brand-blue px-5 py-3 text-sm font-semibold text-white hover:bg-brand-blue-dark"
				>
					Como chegar
				</a>
				<div class="mt-6 overflow-hidden rounded-xl border border-slate-200">
					<iframe
						title="Mapa da Igreja São José Operário"
						src="https://maps.google.com/maps?q=7405%20S%20Redwood%20Rd%20West%20Jordan%20UT&t=&z=15&ie=UTF8&iwloc=&output=embed"
						class="h-56 w-full"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</article>
		</div>

		{
			featured && (
				<article class="mt-8 rounded-2xl border border-brand-gold/40 bg-white p-6 shadow-card">
					<h2 class="text-xl font-bold text-brand-blue">Arte desta missa</h2>
					<p class="mt-2 text-slate-700">{featured.title}</p>
					{mediaUrl(featured.image_key) && (
						<img
							src={mediaUrl(featured.image_key)!}
							alt={`Arte: ${featured.title}`}
							class="mt-4 w-full max-w-xl rounded-xl"
							loading="lazy"
						/>
					)}
				</article>
			)
		}
	</section>
</BaseLayout>
