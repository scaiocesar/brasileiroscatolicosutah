---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, getSettings } from '../lib/db';

const db = getDb(Astro.locals);
const settings = await getSettings(db);
Astro.response.status = 404;
---

<BaseLayout
	title="Página não encontrada"
	description="A página que você procura não existe."
	settings={settings}
>
	<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
		<p class="text-sm font-semibold uppercase tracking-wide text-brand-blue">404</p>
		<h1 class="mt-2 text-3xl font-extrabold text-brand-blue-dark">Página não encontrada</h1>
		<p class="mt-4 text-slate-600">O endereço pode ter mudado. Volte ao início ou veja o horário da missa.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="rounded-full bg-brand-blue px-5 py-3 text-sm font-semibold text-white">Início</a>
			<a href="/missa" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">Missa</a>
		</div>
	</section>
</BaseLayout>
