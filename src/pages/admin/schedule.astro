---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAuth } from '../../lib/admin';
import { getMassSchedule } from '../../lib/db';

const auth = await requireAuth(Astro);
if (auth.redirect) return auth.redirect;
const { user, db } = auth;
if (!db) return Astro.redirect('/admin/login?error=db');

const schedule = await getMassSchedule(db);
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout title="Horário da missa" userName={user!.name} role={user!.role}>
	<h1 class="text-2xl font-bold text-brand-blue-dark">Horário da missa</h1>
	<p class="mt-1 text-sm text-slate-600">Informações recorrentes exibidas na página pública de missa.</p>

	{msg === 'saved' && <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Horário atualizado.</p>}

	<form method="POST" action="/api/schedule" class="mt-6 space-y-4 rounded-2xl border border-slate-200 bg-white p-5">
		<label class="block text-sm font-medium">
			Frequência
			<input name="recurrence" required value={schedule.recurrence} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Horário (AM/PM)
			<input
				name="time_label"
				required
				value={schedule.time_label}
				placeholder="6:00 PM"
				class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
			/>
			<span class="mt-1 block text-xs text-slate-500">Ex.: 6:00 PM</span>
		</label>
		<label class="block text-sm font-medium">
			Igreja
			<input name="church_name" required value={schedule.church_name} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Endereço
			<input name="address" required value={schedule.address} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Padre / celebrante
			<input name="priest" required value={schedule.priest} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Link do mapa
			<input name="maps_url" required value={schedule.maps_url} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Observações
			<textarea name="notes" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">{schedule.notes ?? ''}</textarea>
		</label>
		<button type="submit" class="rounded-full bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white">Salvar</button>
	</form>
</AdminLayout>
