---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAuth } from '../../lib/admin';
import { getActiveFeaturedMass, listPublishedArticles, listUpcomingEvents } from '../../lib/db';

const auth = await requireAuth(Astro);
if (auth.redirect) return auth.redirect;
const { user, db } = auth;
if (!db) return Astro.redirect('/admin/login?error=db');

const featured = await getActiveFeaturedMass(db);
const upcoming = await listUpcomingEvents(db, 5);
const articles = await listPublishedArticles(db, 5);
---

<AdminLayout title="Painel" userName={user!.name} role={user!.role}>
	<h1 class="text-2xl font-bold text-brand-blue-dark">Painel</h1>
	<p class="mt-1 text-sm text-slate-600">Olá, {user!.name}. Gerencie o conteúdo do site.</p>

	<div class="mt-6 grid gap-4 sm:grid-cols-2">
		<div class="rounded-2xl border border-slate-200 bg-white p-5">
			<h2 class="font-bold text-brand-blue">Arte em evidência</h2>
			{
				featured ? (
					<p class="mt-2 text-sm text-slate-700">
						{featured.title}
						<br />
						<span class="text-slate-500">Até {new Date(featured.event_at).toLocaleString('pt-BR')}</span>
					</p>
				) : (
					<p class="mt-2 text-sm text-slate-500">Nenhuma arte ativa no momento.</p>
				)
			}
			<a href="/admin/featured" class="mt-3 inline-block text-sm font-semibold text-brand-blue">Gerenciar →</a>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-5">
			<h2 class="font-bold text-brand-blue">Próximos eventos</h2>
			<p class="mt-2 text-3xl font-extrabold text-slate-900">{upcoming.length}</p>
			<a href="/admin/events" class="mt-3 inline-block text-sm font-semibold text-brand-blue">Gerenciar →</a>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-5">
			<h2 class="font-bold text-brand-blue">Artigos publicados</h2>
			<p class="mt-2 text-3xl font-extrabold text-slate-900">{articles.length}</p>
			<a href="/admin/articles" class="mt-3 inline-block text-sm font-semibold text-brand-blue">Gerenciar →</a>
		</div>
	</div>

	<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
		<a href="/admin/featured" class="rounded-xl bg-brand-blue px-4 py-3 text-center text-sm font-semibold text-white">Publicar arte da missa</a>
		<a href="/admin/missa" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold">Cadastrar missa</a>
		<a href="/admin/events" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold">Novo evento</a>
		<a href="/admin/articles" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold">Novo artigo</a>
		<a href="/admin/about" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold">Editar Sobre</a>
	</div>
</AdminLayout>
