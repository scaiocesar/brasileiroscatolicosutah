---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAuth } from '../../lib/admin';
import { listUsers } from '../../lib/db';

const auth = await requireAuth(Astro, ['admin']);
if (auth.redirect) return auth.redirect;
const { user, db } = auth;
if (!db) return Astro.redirect('/admin/login?error=db');

const users = await listUsers(db);
const editId = Astro.url.searchParams.get('edit');
const editing = editId ? users.find((u) => String(u.id) === editId) : null;
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout title="Usuários" userName={user!.name} role={user!.role}>
	<h1 class="text-2xl font-bold text-brand-blue-dark">Usuários</h1>
	<p class="mt-1 text-sm text-slate-600">Admin gerencia tudo. Editor gerencia artes, horários e eventos.</p>

	{msg === 'saved' && <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Usuário salvo.</p>}

	<form method="POST" action="/api/users" class="mt-6 space-y-4 rounded-2xl border border-slate-200 bg-white p-5">
		<input type="hidden" name="id" value={editing?.id ?? ''} />
		<label class="block text-sm font-medium">
			Nome
			<input name="name" required value={editing?.name ?? ''} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			E-mail
			<input type="email" name="email" required value={editing?.email ?? ''} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Senha {editing ? '(deixe em branco para manter)' : ''}
			<input type="password" name="password" required={!editing} minlength="8" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>
		<label class="block text-sm font-medium">
			Papel
			<select name="role" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
				<option value="editor" selected={editing?.role === 'editor'}>Editor</option>
				<option value="admin" selected={editing?.role === 'admin' || !editing}>Admin</option>
			</select>
		</label>
		<label class="inline-flex items-center gap-2 text-sm">
			<input type="checkbox" name="active" value="1" checked={editing ? editing.active === 1 : true} />
			Ativo
		</label>
		<div class="flex gap-2">
			<button type="submit" class="rounded-full bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white">{editing ? 'Atualizar' : 'Criar usuário'}</button>
			{editing && <a href="/admin/users" class="rounded-full border px-5 py-2.5 text-sm font-semibold">Cancelar</a>}
		</div>
	</form>

	<ul class="mt-8 space-y-3">
		{
			users.map((u) => (
				<li class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4">
					<div>
						<p class="font-semibold">{u.name}</p>
						<p class="text-sm text-slate-600">{u.email} · {u.role} · {u.active ? 'ativo' : 'inativo'}</p>
					</div>
					<a href={`/admin/users?edit=${u.id}`} class="rounded-lg border px-3 py-2 text-sm">Editar</a>
				</li>
			))
		}
	</ul>
</AdminLayout>
