---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAuth } from '../../lib/admin';
import { getSettings, isFeatureEnabled, listAllArticles, mediaUrl, parseGalleryKeys } from '../../lib/db';
import { articleHtmlForEditor } from '../../lib/html';
import { formatDatePt, toDatetimeLocalValue } from '../../lib/dates';

const auth = await requireAuth(Astro);
if (auth.redirect) return auth.redirect;
const { user, db } = auth;
if (!db) return Astro.redirect('/admin/login?error=db');

const settings = await getSettings(db);
const items = await listAllArticles(db);
const editId = Astro.url.searchParams.get('edit');
const editing = editId ? items.find((i) => String(i.id) === editId) : null;
const msg = Astro.url.searchParams.get('msg');
const artigosOn = isFeatureEnabled(settings.page_artigos_enabled);
const editorHtml = articleHtmlForEditor(editing?.body ?? '');
const editingCover = editing ? mediaUrl(editing.cover_image_key) : null;
const editingGallery = editing ? parseGalleryKeys(editing.gallery_keys) : [];
const editingPublishedAt = editing ? toDatetimeLocalValue(editing.published_at) : '';
---

<AdminLayout title="Artigos" userName={user!.name} role={user!.role}>
	<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />

	<h1 class="text-2xl font-bold text-brand-blue-dark">Artigos</h1>
	<p class="mt-1 text-sm text-slate-600">Publique textos sobre a comunidade com formatação e imagens.</p>

	{msg === 'saved' && <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Artigo salvo.</p>}
	{msg === 'deleted' && <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Artigo removido.</p>}
	{msg === 'pages' && <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Visibilidade atualizada.</p>}
	{msg === 'error' && <p class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">Não foi possível salvar o artigo.</p>}

	<form method="POST" action="/api/articles/visibility" class="mt-6 space-y-3 rounded-2xl border border-slate-200 bg-white p-5">
		<p class="text-sm font-semibold text-brand-blue">Visibilidade no site</p>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="page_artigos_enabled" value="1" checked={artigosOn} />
			Exibir página Artigos no menu e no site
		</label>
		<button type="submit" class="rounded-full bg-slate-800 px-4 py-2 text-sm font-semibold text-white">
			Salvar visibilidade
		</button>
	</form>

	<form
		id="article-form"
		method="POST"
		action="/api/articles"
		enctype="multipart/form-data"
		class="mt-6 space-y-4 rounded-2xl border border-slate-200 bg-white p-5"
	>
		<input type="hidden" name="id" value={editing?.id ?? ''} />
		<input type="hidden" name="gallery_keys" id="gallery_keys" value={JSON.stringify(editingGallery)} />

		<label class="block text-sm font-medium">
			Título
			<input name="title" required value={editing?.title ?? ''} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
		</label>

		<label class="block text-sm font-medium">
			Data da publicação
			<input
				type="datetime-local"
				name="published_at"
				value={editingPublishedAt}
				class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
			/>
			<span class="mt-1 block text-xs text-slate-500">Data que aparece no artigo. Deixe em branco para usar a data atual.</span>
		</label>

		<label class="block text-sm font-medium">
			Resumo (opcional)
			<textarea name="excerpt" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="Breve descrição para a listagem">{editing?.excerpt ?? ''}</textarea>
		</label>

		<div class="block text-sm font-medium">
			<span>Conteúdo</span>
			<input type="hidden" name="body" id="article_body" value={editorHtml} />
			<div class="mt-1 overflow-hidden rounded-lg border border-slate-300 bg-white">
				<div id="article-editor"></div>
			</div>
			<span class="mt-1 block text-xs font-normal text-slate-500">
				Use a barra de ferramentas para formatação. Clique no ícone de imagem para enviar fotos no corpo do artigo.
			</span>
		</div>

		<label class="block text-sm font-medium">
			Imagem de capa (opcional)
			<input type="file" name="cover_image" accept="image/*" class="mt-1 w-full text-sm" />
			{
				editingCover ? (
					<span class="mt-2 flex items-start gap-3">
						<img src={editingCover} alt="" class="h-20 w-28 rounded-lg object-cover" />
						<span class="text-xs text-slate-500">Deixe em branco para manter a imagem atual.</span>
					</span>
				) : (
					<span class="mt-1 block text-xs text-slate-500">Aparece na listagem e no topo do artigo.</span>
				)
			}
		</label>
		{
			editingCover && (
				<label class="inline-flex items-center gap-2 text-sm text-red-700">
					<input type="checkbox" name="remove_cover_image" value="1" />
					Remover imagem de capa
				</label>
			)
		}

		<!-- Gallery -->
		<div class="text-sm font-medium">
			<span>Galeria de fotos (opcional)</span>
			<div
				id="gallery-dropzone"
				class="mt-1 flex min-h-[120px] flex-wrap items-start gap-3 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 p-4 transition hover:border-brand-blue"
			>
				<div id="gallery-items" class="flex flex-wrap gap-3"></div>
				<div id="gallery-placeholder" class="flex w-full items-center justify-center py-6 text-slate-400">
					Arraste fotos aqui ou clique para adicionar
				</div>
			</div>
			<input type="file" id="gallery-file-input" accept="image/*" multiple class="hidden" />
			<span class="mt-1 block text-xs text-slate-500">
				Arraste para reordenar. Clique no × para remover. As fotos aparecem abaixo do artigo.
			</span>
		</div>

		<label class="inline-flex items-center gap-2 text-sm">
			<input type="checkbox" name="published" value="1" checked={editing ? editing.published === 1 : true} />
			Publicado
		</label>
		<div class="flex flex-wrap gap-2">
			<button type="submit" class="rounded-full bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white">
				{editing ? 'Atualizar' : 'Criar artigo'}
			</button>
			{editing && (
				<a href="/admin/articles" class="rounded-full border px-5 py-2.5 text-sm font-semibold">
					Cancelar
				</a>
			)}
		</div>
	</form>

	<ul class="mt-8 space-y-3">
		{
			items.map((item) => (
				<li class="rounded-2xl border border-slate-200 bg-white p-4">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
						<div class="flex gap-3">
							{mediaUrl(item.cover_image_key) && (
								<img
									src={mediaUrl(item.cover_image_key)!}
									alt=""
									class="h-16 w-24 shrink-0 rounded-lg object-cover"
								/>
							)}
							<div>
								<p class="font-semibold">{item.title}</p>
								<p class="text-sm text-slate-600">{formatDatePt(item.published_at)}</p>
								{item.excerpt && <p class="mt-1 line-clamp-2 text-sm text-slate-500">{item.excerpt}</p>}
								{item.published === 0 && <p class="mt-1 text-xs font-semibold text-amber-700">Rascunho</p>}
							</div>
						</div>
						<div class="flex gap-2">
							<a href={`/admin/articles?edit=${item.id}`} class="rounded-lg border px-3 py-2 text-sm">
								Editar
							</a>
							<form method="POST" action="/api/articles/delete">
								<input type="hidden" name="id" value={item.id} />
								<button
									type="submit"
									class="rounded-lg border border-red-200 px-3 py-2 text-sm text-red-700"
									onclick="return confirm('Excluir artigo?')"
								>
									Excluir
								</button>
							</form>
						</div>
					</div>
				</li>
			))
		}
	</ul>

	<script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
	<script is:inline>
		(function () {
			// --- Quill editor ---
			const form = document.getElementById('article-form');
			const hidden = document.getElementById('article_body');
			const mount = document.getElementById('article-editor');
			if (!form || !hidden || !mount || typeof Quill === 'undefined') return;

			const initial = hidden.value || '<p><br></p>';

			const quill = new Quill(mount, {
				theme: 'snow',
				placeholder: 'Escreva o artigo…',
				modules: {
					toolbar: [
						[{ header: [2, 3, false] }],
						['bold'],
						[{ list: 'ordered' }, { list: 'bullet' }],
						['link', 'image'],
						['clean'],
					],
				},
			});

			quill.root.innerHTML = initial;

			const toolbar = quill.getModule('toolbar');
			toolbar.addHandler('image', function () {
				const input = document.createElement('input');
				input.setAttribute('type', 'file');
				input.setAttribute('accept', 'image/*');
				input.click();
				input.onchange = async function () {
					const file = input.files && input.files[0];
					if (!file) return;
					const url = await uploadImage(file);
					if (!url) return;
					const range = quill.getSelection(true);
					quill.insertEmbed(range.index, 'image', url);
					quill.setSelection(range.index + 1);
				};
			});

			async function uploadImage(file) {
				const fd = new FormData();
				fd.append('image', file);
				try {
					const res = await fetch('/api/articles/upload-image', {
						method: 'POST',
						body: fd,
						credentials: 'same-origin',
					});
					const data = await res.json();
					if (!res.ok || !data.url) {
						alert('Não foi possível enviar a imagem.');
						return null;
					}
					return data.url;
				} catch {
					alert('Não foi possível enviar a imagem.');
					return null;
				}
			}

			// --- Gallery drag-n-drop ---
			const galleryHidden = document.getElementById('gallery_keys');
			const dropzone = document.getElementById('gallery-dropzone');
			const galleryItems = document.getElementById('gallery-items');
			const galleryPlaceholder = document.getElementById('gallery-placeholder');
			const galleryFileInput = document.getElementById('gallery-file-input');

			let galleryKeys = [];
			try {
				galleryKeys = JSON.parse(galleryHidden.value || '[]');
			} catch { galleryKeys = []; }

			function renderGallery() {
				galleryItems.innerHTML = '';
				galleryPlaceholder.style.display = galleryKeys.length === 0 ? '' : 'none';
				galleryKeys.forEach(function (key, idx) {
					const url = '/api/media/' + key;
					const wrapper = document.createElement('div');
					wrapper.className = 'relative group';
					wrapper.draggable = true;
					wrapper.dataset.idx = idx;
					wrapper.innerHTML =
						'<img src="' + url + '" class="h-24 w-24 rounded-lg object-cover cursor-grab active:cursor-grabbing" />' +
						'<button type="button" class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-red-600 text-[10px] font-bold text-white opacity-0 transition group-hover:opacity-100" data-remove="' + idx + '">×</button>';
					galleryItems.appendChild(wrapper);
				});
				galleryHidden.value = JSON.stringify(galleryKeys);
			}

			// Remove handler
			galleryItems.addEventListener('click', function (e) {
				const btn = e.target.closest('[data-remove]');
				if (!btn) return;
				e.preventDefault();
				const idx = parseInt(btn.dataset.remove, 10);
				galleryKeys.splice(idx, 1);
				renderGallery();
			});

			// Drag-n-drop reorder
			let dragIdx = null;
			galleryItems.addEventListener('dragstart', function (e) {
				const wrapper = e.target.closest('[data-idx]');
				if (!wrapper) return;
				dragIdx = parseInt(wrapper.dataset.idx, 10);
				wrapper.style.opacity = '0.4';
			});
			galleryItems.addEventListener('dragend', function (e) {
				const wrapper = e.target.closest('[data-idx]');
				if (wrapper) wrapper.style.opacity = '';
				dragIdx = null;
			});
			galleryItems.addEventListener('dragover', function (e) {
				e.preventDefault();
			});
			galleryItems.addEventListener('drop', function (e) {
				e.preventDefault();
				const wrapper = e.target.closest('[data-idx]');
				if (!wrapper || dragIdx === null) return;
				const dropIdx = parseInt(wrapper.dataset.idx, 10);
				if (dragIdx === dropIdx) return;
				const item = galleryKeys.splice(dragIdx, 1)[0];
				galleryKeys.splice(dropIdx, 0, item);
				renderGallery();
			});

			// External file drop
			dropzone.addEventListener('dragover', function (e) {
				e.preventDefault();
				dropzone.classList.add('border-brand-blue', 'bg-blue-50');
			});
			dropzone.addEventListener('dragleave', function (e) {
				dropzone.classList.remove('border-brand-blue', 'bg-blue-50');
			});
			dropzone.addEventListener('drop', function (e) {
				e.preventDefault();
				dropzone.classList.remove('border-brand-blue', 'bg-blue-50');
				const files = e.dataTransfer && e.dataTransfer.files;
				if (files && files.length > 0) addGalleryFiles(files);
			});

			// Click to add
			dropzone.addEventListener('click', function (e) {
				if (e.target.closest('button') || e.target.closest('img')) return;
				galleryFileInput.click();
			});
			galleryFileInput.addEventListener('change', function () {
				if (galleryFileInput.files && galleryFileInput.files.length > 0) {
					addGalleryFiles(galleryFileInput.files);
				}
				galleryFileInput.value = '';
			});

			async function addGalleryFiles(files) {
				for (let i = 0; i < files.length; i++) {
					const file = files[i];
					if (!file.type.startsWith('image/')) continue;
					const fd = new FormData();
					fd.append('image', file);
					try {
						const res = await fetch('/api/articles/upload-image', {
							method: 'POST',
							body: fd,
							credentials: 'same-origin',
						});
						const data = await res.json();
						if (res.ok && data.url) {
							// url is /api/media/KEY — extract key
							const key = data.url.replace('/api/media/', '');
							galleryKeys.push(key);
							renderGallery();
						}
					} catch { /* ignore */ }
				}
			}

			renderGallery();

			// --- Form submit ---
			form.addEventListener('submit', function () {
				const html = quill.root.innerHTML;
				const text = quill.getText().trim();
				hidden.value = text ? html : '';
				galleryHidden.value = JSON.stringify(galleryKeys);
			});
		})();
	</script>

	<style is:global>
		#article-editor.ql-container.ql-snow {
			border: none;
			font-size: 0.95rem;
		}
		#article-editor .ql-editor {
			min-height: 280px;
		}
		#article-editor .ql-editor a {
			color: #1d4ed8;
			text-decoration: underline;
		}
		#article-editor .ql-editor img {
			max-width: 100%;
			height: auto;
			border-radius: 0.5rem;
		}
		.ql-toolbar.ql-snow {
			border: none;
			border-bottom: 1px solid #cbd5e1;
			background: #f8fafc;
		}
	</style>
</AdminLayout>
